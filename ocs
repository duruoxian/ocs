def show_group_preview(con, key):
    """分组行预览：key 为 p:<项目id> 或 d:<运行目录>。"""
    if key.startswith("p:"):
        prow = con.execute(
            "SELECT id, worktree, name FROM project WHERE id = ?", (key[2:],)
        ).fetchone()
        if not prow:
            print(D("（未知项目）"))
            return
        rows = load_sessions(con, prow["id"])
        label = prow["name"] or os.path.basename((prow["worktree"] or "?").rstrip("/")) or prow["worktree"]
        path = prow["worktree"] or "?"
    else:
        d = key[2:]
        rows = [r for r in load_sessions(con, None) if (r.get("directory") or "") == d]
        label = os.path.basename(d.rstrip("/")) or d
        path = d
    print(B(C("◆ " + label)))
    print(f"{D('路径')}   {path}")
    if not rows:
        print(D("（没有会话）"))
