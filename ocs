              for x in rows)
    cost = sum(x["cost"] or 0 for x in rows)
    print(f"{D('会话')}   {len(rows)} 个 · 最近活跃 {rel_time(rows[0]['time_updated'])}")
    seg = f"共 {fmt_tok(tot)} tokens"
    if cost:
        seg += f" · 共 ${cost:.4f}"
    print(f"{D('统计')}   {seg}")
    print(f"{D('最新')}   {trunc(rows[0]['title'], 40)}")


