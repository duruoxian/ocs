# ---------- 基础工具 ----------

def db_path(required=True):
    cands = []
    if os.environ.get("OPENCODE_DATA"):
        cands.append(os.path.join(os.environ["OPENCODE_DATA"], "opencode.db"))
    xdg = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    cands.append(os.path.join(xdg, "opencode", "opencode.db"))
    for c in cands:
        if os.path.isfile(c):
            return c
    if not required:  # 多工具模式：没装 opencode 也能只看 claude/codex
        return None
    sys.exit("找不到 opencode 数据库，尝试过:\n  " + "\n  ".join(cands))


def connect():
    con = sqlite3.connect("file:" + pathname2url(db_path()) + "?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    return con


def dw(s):
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in s)


def pad(s, w):
    return s + " " * max(0, w - dw(s))


def trunc(s, n):
    s = " ".join((s or "").split())
    if dw(s) <= n:
        return s
    out, w = [], 0
    for ch in s:  # 按显示宽度截断：CJK 占 2 列，按字符数切会把列挤歪
        cw = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if w + cw > n - 1:
            break
        out.append(ch)
        w += cw
    return "".join(out) + "…"


def clean_text(t):
    t = (t or "").strip()
    if len(t) >= 2 and t[0] == '"' and t[-1] == '"':
        try:
            v = json.loads(t)
            if isinstance(v, str):
                t = v
        except ValueError:
            pass
    return t


def oneline(s):
    """压成单行：fzf 的列表项/隐藏字段不能含换行或制表符。"""
    return " ".join((s or "").split())


def rel_time(ms):
    dt = datetime.fromtimestamp(ms / 1000)
    sec = (datetime.now() - dt).total_seconds()
    if sec < 60:
        return "刚刚"
    if sec < 3600:
        return f"{int(sec // 60)} 分钟前"
    if sec < 86400:
        return f"{int(sec // 3600)} 小时前"
    if sec < 7 * 86400:
        return f"{int(sec // 86400)} 天前"
    if dt.year == datetime.now().year:
        return dt.strftime("%m-%d %H:%M")
    return dt.strftime("%Y-%m-%d")


def abs_time(ms):
    return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M:%S")


def fmt_tok(n):
    if n >= 10000:
        return f"{n / 1000:.0f}k"
    if n >= 1000:
        return f"{n / 1000:.1f}k"
    return str(n)


def self_path():
    try:  # 优先脚本真实路径：argv[0] 经 which 会解析到旧安装副本（开发/测试踩过）
        return os.path.abspath(__main__.__file__)
    except (AttributeError, NameError, OSError):
        pass
    a0 = sys.argv[0]
    if os.path.sep in a0:
        return os.path.abspath(a0)
    return shutil.which(a0) or os.path.abspath(a0)


def self_cmd():
    """把「重新调用本脚本」做成一条 shell 命令片段（供 fzf execute/preview 用）。"""
    if IS_WIN:
        return q(sys.executable) + " " + q(self_path())
    return shlex.quote(self_path())


# ---------- 鼠标归属运行时切换 ----------
# 终端里鼠标同一时刻只能归一边：程序占用时可点击列表，但拖动/右键归程序。
# 通过转义序列在运行时切换（Konsole 实时解析，fzf 无感知），
# 让"拖动选字 + 右键复制菜单"随用随取，无需 Shift。
MOUSE_OFF = "\033[?1000l\033[?1002l\033[?1006l"  # 鼠标归终端：拖动选字、右键菜单
MOUSE_ON = "\033[?1000h\033[?1002h\033[?1006h"   # 鼠标归程序：点击列表、双击继续


def _state_dir():
    try:
        d = os.path.join(tempfile.gettempdir(), "ocs")
        os.makedirs(d, exist_ok=True)
        return d
    except OSError:
        return tempfile.gettempdir()


def _tty_id():
    """当前终端的一个稳定标识：同一终端里的所有 ocs 子进程应得到同一个值。"""
    if IS_WIN:
        try:
            import ctypes
            hwnd = ctypes.windll.kernel32.GetConsoleWindow()
            if hwnd:
                return "win-%x" % hwnd  # fzf 的 execute 子进程共享同一控制台窗口
        except Exception:
            pass
        for v in ("WT_SESSION", "SESSIONNAME", "TERM_SESSION_ID"):
            if os.environ.get(v):
                return "env-" + re.sub(r"[^0-9A-Za-z]", "", os.environ[v])[:24]
        return "pid-" + str(os.getpid())
    try:
        return os.path.basename(os.path.realpath("/dev/tty"))
    except OSError:
        return "default"


def mouse_state_path():
    if IS_WIN:
        return os.path.join(_state_dir(), "mouse-" + _tty_id())
    return "/tmp/ocs-mouse-" + _tty_id()


def write_tty(s):
    if IS_WIN:  # 鼠标归属切换是 Linux 终端专属，Windows 下忽略
        return
    try:
        fd = os.open("/dev/tty", os.O_WRONLY)
        try:
            os.write(fd, s.encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def cmd_select_mouse():
    """把鼠标交给终端：拖动即选字、右键即「复制」菜单（不用 Shift）。F8 可切回。"""
    with open(mouse_state_path(), "w") as f:
        f.write("select")
    write_tty(MOUSE_OFF)


def cmd_toggle_mouse():
    """F8：在 点击模式 与 选字模式 之间切换。"""
    p = mouse_state_path()
    if os.path.exists(p):
        os.unlink(p)
        write_tty(MOUSE_ON)
    else:
        cmd_select_mouse()


# ---------- 对话视图（默认只显示用户提问，点击展开/折叠 AI 回答） ----------

def ui_state_path():
    if IS_WIN:
        return os.path.join(_state_dir(), "ui-" + _tty_id())
    return "/tmp/ocs-ui-" + _tty_id()


def ui_state():
    try:
        with open(ui_state_path()) as f:
            st = json.load(f)
            if isinstance(st, dict):
                return st
    except (OSError, ValueError):
        pass
    return {"view": "list"}


def ui_state_set(st):
    try:
        with open(ui_state_path(), "w") as f:
            json.dump(st, f)
    except OSError:
        pass


def ui_state_clear():
    try:
        os.unlink(ui_state_path())
    except OSError:
        pass


def parse_msg_id(mid):
    """消息行 id 形如 m:<tool>:<session_id>:<序号>；不是消息行返回 None。"""
    if not mid.startswith("m:"):
        return None
    parts = mid.split(":")
    if len(parts) != 4 or not parts[3].isdigit():
        return None
    tool, sid = split_key(parts[1] + ":" + parts[2])
    if tool is None:
        return None
    return tool, sid, int(parts[3])


def toggle_msg(mid):
    """点击/展开某条消息：切换其 AI 回答的显示状态。"""
    pm = parse_msg_id(mid)
    if not pm:
        return
    tool, sid, idx = pm
    st = ui_state()
    if st.get("view") != "msg" or st.get("key") != tool + ":" + sid:
        return
    exp = set(st.get("expanded", []))
    exp.symmetric_difference_update({idx})
    st["expanded"] = sorted(exp)
    ui_state_set(st)


def cmd_nav_right(mid):
    """→：会话行=打开对话视图；消息行=展开/折叠 AI 回答。"""
    pm = parse_msg_id(mid)
    if pm:
        toggle_msg(mid)
        return
    key = mid[5:] if mid.startswith("@ses:") else (mid if split_key(mid)[0] else None)
    if key:  # oc:ses_x / cc:uuid / cx:id → 打开该会话的对话视图
        ui_state_set({"view": "msg", "key": key, "expanded": []})


def cmd_nav_left(mid):
    """←：返回会话列表。"""
    ui_state_set({"view": "list"})


def cmd_click(mid):
    """单击：工具行=切换工具；返回行=回到列表；消息行=展开/折叠；其他行不做事。"""
    if mid.startswith("@tool:"):
        t = mid[6:]
        if t in ADAPTERS:
            set_tool(t)
            kill_fzf()  # 让 fzf 退出 → 外层以新工具重启（header/列表一起换）
        return
    if mid == "@back":
        return cmd_nav_left(mid)
    toggle_msg(mid)


def message_pairs(con, sid, upto=None):
    """按时间正序返回 [(用户消息, 紧随其后的 AI 回复文本或 "")]。

    单次 JOIN 查询取整个会话的消息与文本 part（原先每条消息一次查询）；
    upto=N 时凑够 N+1 对即停，预览单条消息不必拉全整个会话。
    """
    def flush(pair):
        body = "\n\n".join(x.strip() for x in texts if x.strip())
        if role == "user":
            if pair:
                pairs.append(pair)
            return [body, ""]
        if role == "assistant" and pair is not None:
            pair[1] = (pair[1] + "\n\n" + body).strip() if pair[1] else body
        return pair

    cur = con.execute(
        """SELECT m.id, m.data, p2.data
           FROM message m LEFT JOIN part p2
             ON p2.message_id = m.id AND json_extract(p2.data, '$.type') = 'text'
           WHERE m.session_id = ?
           ORDER BY m.time_created, m.id, p2.id""",
        (sid,),
    )
    pairs, pair = [], None
    role, texts, last_mid = None, [], None
    for mid, mdata, pdata in cur:
        if upto is not None and len(pairs) > upto:
            return pairs
        if mid != last_mid:
            pair = flush(pair)
            texts = []
            last_mid = mid
            try:
                role = json.loads(mdata).get("role")
            except (ValueError, AttributeError):
                role = None
        if pdata:
            try:
                t = clean_text(json.loads(pdata).get("text", ""))
            except (ValueError, AttributeError):
                t = ""
            texts.append(t)
    pair = flush(pair)
    if pair:  # 最后一对问答不在任何“下一条消息”的 flush 里，这里补上
        pairs.append(pair)
    return pairs


# ---------- 数据库查询 ----------

SQL = """
SELECT s.id, s.title, s.directory, s.time_created, s.time_updated,
       s.cost, s.tokens_input, s.tokens_output, s.tokens_reasoning,
       s.model, s.agent, s.summary_additions, s.summary_deletions, s.summary_files,
       p.id AS pid, p.name AS pname, p.worktree AS worktree
FROM session s LEFT JOIN project p ON p.id = s.project_id
WHERE s.parent_id IS NULL AND s.time_archived IS NULL
"""


def find_row(con, sid):
    r = con.execute(SQL + " AND s.id = ?", (sid,)).fetchone()
    if r:
        return r
    if len(sid) >= 6:  # 允许传 id 前缀，只要能唯一匹配
        rows = con.execute(SQL + " AND s.id LIKE ? || '%'", (sid,)).fetchall()
        if len(rows) == 1:
            return rows[0]
        if len(rows) > 1:
            sys.exit("前缀 %r 匹配到多个会话，请用更长的 id:\n  "
                     % sid + "\n  ".join(x["id"] for x in rows))
    return None


def group_of(r):
    """分组键：真实项目按项目分组；挂在 '/' 下的会话按实际运行目录分组。"""
    wt = r.get("worktree") or ""
    if wt and wt != "/" and r.get("pid"):
        return ("p:" + r["pid"], r.get("pname") or proj_label(r), wt)
    d = r.get("directory") or wt or "?"
    return ("d:" + d, os.path.basename(d.rstrip("/\\")) or d, d)


def _chunked(items, size=400):
    for i in range(0, len(items), size):
        yield items[i:i + size]


def batch_user_texts(con, sids, limit=60):
    """一次查询取所有会话的用户提问文本（每会话前 limit 条，时间正序）。

    供标题回退与内容搜索共用；原先每会话一条查询，会话一多每次 reload 全是 N+1。
    """
    out = {}
    sids = list(sids)
    if not sids:
        return out
    for chunk in _chunked(sids):
        qm = ",".join("?" * len(chunk))
        for sid, d in con.execute(
            f"""SELECT session_id, data FROM (
                  SELECT m.session_id AS session_id, p2.data AS data,
                         ROW_NUMBER() OVER (PARTITION BY m.session_id
                                            ORDER BY m.time_created, p2.id) rn
                  FROM message m JOIN part p2 ON p2.message_id = m.id
                  WHERE m.session_id IN ({qm})
                    AND json_extract(m.data, '$.role') = 'user'
                    AND json_extract(p2.data, '$.type') = 'text'
                ) WHERE rn <= {int(limit)} ORDER BY session_id, rn""",
            chunk,
        ):
            try:
                t = clean_text(json.loads(d).get("text", ""))
            except (ValueError, AttributeError):
                t = ""
            if t:
                out.setdefault(sid, []).append(t)
    return out


def batch_last_replies(con, sids):
    """一次查询取每个会话最后一条 AI 回复的文本。返回 {sid: text}。"""
    out = {}
    sids = list(sids)
    if not sids:
        return out
    for chunk in _chunked(sids):
        qm = ",".join("?" * len(chunk))
        for sid, d in con.execute(
            f"""SELECT session_id, data FROM (
                  SELECT m.session_id AS session_id, p2.data AS data, p2.id,
                         DENSE_RANK() OVER (PARTITION BY m.session_id
                                            ORDER BY m.time_created DESC, m.id DESC) rnk
                  FROM message m JOIN part p2 ON p2.message_id = m.id
                  WHERE m.session_id IN ({qm})
                    AND json_extract(m.data, '$.role') = 'assistant'
                    AND json_extract(p2.data, '$.type') = 'text'
                ) WHERE rnk = 1 ORDER BY session_id, id""",
            chunk,
        ):
            try:
                t = clean_text(json.loads(d).get("text", ""))
            except (ValueError, AttributeError):
                t = ""
            if t:
                out.setdefault(sid, []).append(t)
    return {s: "\n".join(ts) for s, ts in out.items()}


def build_search(texts, reply):
    """会话内容摘要（fzf 隐藏字段，供全文搜索）：全部用户提问 + 最后一条回复。"""
    parts = [oneline(t)[:200] for t in texts]
    if reply:
        parts.append(oneline(reply)[:200])
    return " ".join(parts)[:4000]


def load_sessions(con, pid=None):
    sql, params = SQL, []
    if pid:
        sql += " AND s.project_id = ?"
        params.append(pid)
    rows = [dict(r) for r in con.execute(sql, params)]
    counts = dict(con.execute("SELECT session_id, COUNT(*) FROM message GROUP BY session_id"))
    sids = [r["id"] for r in rows]
    utexts = batch_user_texts(con, sids)
    replies = batch_last_replies(con, sids)
    for r in rows:
        r["msgs"] = counts.get(r["id"], 0)
        texts = utexts.get(r["id"], [])
        t = (r["title"] or "").strip()
        if t.lower() in TITLE_FALLBACKS:
            t = ""
        if not t:  # 标题回退与 ensure_title 一致，批量做省去每会话一条查询
            t = trunc(texts[0], 30) if texts else "(无标题)"
        r["title"] = t
        r["search"] = build_search(texts, replies.get(r["id"], ""))
        r["gkey"], r["glabel"], r["gpath"] = group_of(r)
    rows.sort(key=lambda r: r["time_updated"], reverse=True)
    return rows


def ensure_title(con, r):
    t = (r["title"] or "").strip()
    if t.lower() in TITLE_FALLBACKS:
        t = ""
    if not t:
        texts = first_user_texts(con, r["id"], 1)
        t = trunc(texts[0], 30) if texts else "(无标题)"
    r["title"] = t


def first_user_texts(con, sid, limit=None):
    """某会话的用户消息文本，时间正序（复用批量查询，避免第二份 SQL）。"""
    return batch_user_texts(con, [sid], limit or 60).get(sid, [])


def model_of(con, r):
    m = r.get("model")
    if m:
        if m.startswith("{"):  # session.model 存的是 JSON 对象
            try:
                mm = json.loads(m)
                return f"{mm.get('providerID', '?')}/{mm.get('id') or mm.get('modelID', '?')}"
            except ValueError:
                pass
        return m
    q = con.execute(
        """SELECT data FROM message WHERE session_id = ?
           AND json_extract(data, '$.model') IS NOT NULL
           ORDER BY time_created LIMIT 1""",
        (r["id"],),
    ).fetchone()
    if q:
        try:
            mm = json.loads(q[0])["model"]
            return f"{mm.get('providerID', '?')}/{mm.get('modelID', '?')}"
        except (ValueError, KeyError):
            pass
    return "—"


def proj_label(r):
    if r.get("pname"):
        return r["pname"]
    wt = r.get("worktree") or ""
    if wt == "/":
        return "/"
    return os.path.basename(wt.rstrip("/\\")) or wt or "?"


def dir_match(d, target):
    d = (d or "").replace("\\", "/").rstrip("/") or "/"
    t = (target or "").replace("\\", "/").rstrip("/") or "/"
    if IS_WIN:
        d, t = d.lower(), t.lower()
    return t == d or t.startswith(d.rstrip("/") + "/")


# ---------- 多工具适配层 ----------
# 三家 CLI 的会话统一成一种行结构，上层（列表/预览/动作）只认行不认工具：
#   行字段: tool/id/key/title/directory/path/time_created/time_updated/msgs/
#           tokens_input/output/reasoning/cost/model/search/gkey/glabel/gpath
#   key = "<前缀>:<会话id>"（oc:ses_x · cc:uuid · cx:id），是 fzf 的隐藏字段 2
# opencode 走 SQLite（复用上方查询函数）；claude code / codex 是 JSONL 文件，
# mtime+size 没变就用缓存行（/tmp/ocs/filecache.json），坏文件/坏行跳过不拖垮列表。

ADAPTERS = {
    "oc": {"name": "opencode", "cmd": "opencode", "rename_ok": True, "fork_ok": True},
    "cc": {"name": "claude code", "cmd": "claude", "rename_ok": False, "fork_ok": False},
    "cx": {"name": "codex", "cmd": "codex", "rename_ok": False, "fork_ok": False},
}


def split_key(key):
    """'cc:c1' → ('cc', 'c1')；无前缀视作 opencode（兼容旧的 ses_* 用法）。"""
    key = key or ""
    if ":" in key:
        p, _, i = key.partition(":")
        if p in ADAPTERS and i:
            return p, i
    if key.startswith("ses"):
        return "oc", key
    return None, key


def ts_ms(s):
    """ISO 8601 → 毫秒时间戳（与 opencode.db 的毫秒时间对齐；naive 视作本地时间）。"""
    s = (s or "").strip()
    if not s:
        return 0
    if s[-1] in "Zz":
        s = s[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        try:
            dt = datetime.fromisoformat(s[:19])
        except ValueError:
            return 0
    if dt.tzinfo is None:
        dt = dt.astimezone()
    return int(dt.timestamp() * 1000)


def _pair_seq(seq):
    """[(role, text)] 时间正序 → [(用户提问, AI 回答)]；语义与 message_pairs 一致。"""
    pairs, pair = [], None
    for role, text in seq:
        if role == "user":
            if pair:
                pairs.append(pair)
            pair = [text, ""]
        elif role == "assistant" and pair is not None:
            pair[1] = (pair[1] + "\n\n" + text).strip() if pair[1] else text
    if pair:  # 最后一对问答同样要在这里补上（oc 版踩过的坑）
        pairs.append(pair)
    return pairs


def _json_lines(path):
    """逐行读 JSONL；坏行直接跳过（一个坏文件不该拖垮整个列表）。"""
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if isinstance(obj, dict):
                yield obj


def _text_blocks(content):
    """消息 content → 正文：字符串直接用；列表只取 text 块（tool_result 等跳过）。"""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [str(c.get("text") or "") for c in content
                 if isinstance(c, dict) and c.get("type") in ("text", "input_text", "output_text")]
        return "\n\n".join(p for p in parts if p.strip())
    return ""


def _save_json(path, obj):
    try:
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(obj, f, ensure_ascii=False)
        os.replace(tmp, path)
    except OSError:
        pass


def _scan_rows(tool, root, parse_file):
    """扫描 root 下全部 *.jsonl 生成会话行；mtime+size 未变的文件直接用缓存。"""
    if not os.path.isdir(root):
        return []
    cache_path = os.path.join(_state_dir(), "filecache.json")
    try:
        with open(cache_path, encoding="utf-8") as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    bucket, fresh, rows = cache.get(tool, {}), {}, []
    for dirpath, _, files in os.walk(root):
        for fn in sorted(files):
            if not fn.endswith(".jsonl"):
                continue
            path = os.path.join(dirpath, fn)
            try:
                st = os.stat(path)
            except OSError:
                continue
            ent = bucket.get(path)
            if ent and ent.get("m") == st.st_mtime and ent.get("s") == st.st_size:
                fresh[path] = ent
                rows.append(ent["row"])
                continue
            row = parse_file(path)
            if row is not None:
                ent = {"m": st.st_mtime, "s": st.st_size, "row": row}
                fresh[path] = ent
                rows.append(row)
    if fresh != bucket:  # 有新增/失效才落盘（纯命中时不写）
        cache[tool] = fresh
        _save_json(cache_path, cache)
    return rows


def _cc_parse(path, seq_out=None):
    """Claude Code 会话文件 → 行（无有效消息返回 None）。
    seq_out 传列表时顺带写入 (role, text) 序列，供对话视图复用同一次解析。"""
    seq, title, sid, cwd, model = [], "", "", "", ""
    cost, msgs, tc, tu = 0.0, 0, 0, 0
    for obj in _json_lines(path):
        t = obj.get("type")
        if t == "summary" and not title:
            title = str(obj.get("summary") or "")
            continue
        if t not in ("user", "assistant") or obj.get("isSidechain"):
            continue
        msg = obj.get("message") or {}
        role = msg.get("role")
        body = _text_blocks(msg.get("content"))
        ts = ts_ms(obj.get("timestamp"))
        sid = sid or str(obj.get("sessionId") or "")
        cwd = cwd or str(obj.get("cwd") or "")
        tc = tc or ts
        tu = max(tu, ts)
        if role == "assistant":
            model = str(msg.get("model") or "") or model
            try:
                cost += float(obj.get("costUSD") or 0)
            except (TypeError, ValueError):
                pass
        msgs += 1
        if body:
            seq.append((role, body))
    if seq_out is not None:
        seq_out.extend(seq)
    if not seq or not tu:
        return None
    texts = [b for r, b in seq if r == "user"]
    reply = next((b for r, b in reversed(seq) if r == "assistant"), "")
    return {
        "tool": "cc", "id": sid or os.path.splitext(os.path.basename(path))[0],
        "path": path, "directory": cwd, "title": title, "model": model,
        "time_created": tc, "time_updated": tu, "msgs": msgs,
        "npairs": len(_pair_seq(seq)), "cost": round(cost, 6),
        "tokens_input": 0, "tokens_output": 0, "tokens_reasoning": 0,
        "texts": texts, "_reply": reply,
    }


def _cx_parse(path, seq_out=None):
    """Codex 会话文件（信封式 JSONL）→ 行（无有效消息返回 None）。seq_out 同 _cc_parse。"""
    seq, sid, cwd, model = [], "", "", ""
    ti = to = msgs = tc = tu = 0
    for obj in _json_lines(path):
        t, payload = obj.get("type"), (obj.get("payload") or {})
        ts = ts_ms(obj.get("timestamp"))
        if t == "session_meta":
            sid = str(payload.get("id") or "")
            cwd = str(payload.get("cwd") or "")
            tc = tc or ts
        elif t == "response_item" and payload.get("type") == "message":
            role = payload.get("role")
            body = _text_blocks(payload.get("content"))
            if role in ("user", "assistant"):
                msgs += 1
                if body:
                    seq.append((role, body))
        elif t == "turn_context":
            model = str(payload.get("model") or "") or model
        elif t == "event_msg" and payload.get("type") == "token_count":
            tot = ((payload.get("info") or {}).get("total_token_usage") or {})
            ti = int(tot.get("input_tokens") or 0)
            to = int(tot.get("output_tokens") or 0)
        if ts:
            tc = tc or ts
            tu = max(tu, ts)
    if seq_out is not None:
        seq_out.extend(seq)
    if not seq or not tu:
        return None
    texts = [b for r, b in seq if r == "user"]
    reply = next((b for r, b in reversed(seq) if r == "assistant"), "")
    return {
        "tool": "cx", "id": sid or os.path.splitext(os.path.basename(path))[0],
        "path": path, "directory": cwd, "title": "", "model": model,
        "time_created": tc, "time_updated": tu, "msgs": msgs,
        "npairs": len(_pair_seq(seq)), "cost": 0.0,
        "tokens_input": ti, "tokens_output": to, "tokens_reasoning": 0,
        "texts": texts, "_reply": reply,
    }


def cc_root():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def cx_root():
    return os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")


def _finalize_rows(prefix, rows):
    for r in rows:
        r["key"] = prefix + ":" + r["id"]
        t = r["title"] or (trunc(r["texts"][0], 30) if r.get("texts") else "")
        r["title"] = t or "(无标题)"
        r["search"] = build_search(r.get("texts") or [], r.get("_reply") or "")
        d = r["directory"] or "?"
        r["gkey"], r["glabel"], r["gpath"] = "d:" + d, os.path.basename(d.rstrip("/\\")) or d, d
    return rows


def cc_load():
    return _finalize_rows("cc", _scan_rows("cc", os.path.join(cc_root(), "projects"), _cc_parse))


def cx_load():
    return _finalize_rows("cx", _scan_rows("cx", os.path.join(cx_root(), "sessions"), _cx_parse))


_oc_con_cache = []


def _oc_con():
    """opencode 数据库连接（本进程内懒加载、只此一份；只读）。"""
    if not _oc_con_cache:
        _oc_con_cache.append(connect())
    return _oc_con_cache[0]


def load_all(under=None, tool=None):
    """会话行（时间倒序）。under 给定时只留该目录下（含子目录）的会话；
    tool 给定时只载入那一家的数据（单工具视图）。"""
    rows = []
    if tool in (None, "oc") and db_path(required=False):
        oc_rows = load_sessions(_oc_con())
        for r in oc_rows:  # oc 行也统一打上 tool/key，后面各层不再分叉
            r["tool"] = "oc"
            r["key"] = "oc:" + r["id"]
        rows += oc_rows
    if tool in (None, "cc"):
        rows += cc_load()
    if tool in (None, "cx"):
        rows += cx_load()
    if under:
        rows = [r for r in rows if dir_match(r.get("directory"), under)]
    rows.sort(key=lambda r: r["time_updated"], reverse=True)
    return rows


def find_session(key):
    """按 key 取会话行；找不到返回 None（oc 的前缀歧义会列出候选后退出）。"""
    tool, sid = split_key(key)
    if tool is None:
        return None
    if tool == "oc":
        if not db_path(required=False):
            return None
        row = find_row(_oc_con(), sid)
        if not row:
            return None
        r = dict(row)
        r["tool"], r["key"] = "oc", "oc:" + r["id"]
        return r
    for r in (cc_load() if tool == "cc" else cx_load()):
        if r["id"] == sid:
            return r
    return None


def pairs_of(tool, sid, upto=None):
    """某会话的问答对；与 oc 的 message_pairs 同语义（含 upto 凑够即停）。"""
    if tool == "oc":
        return message_pairs(_oc_con(), sid, upto)
    row = find_session(tool + ":" + sid)
    if not row:
        return []
    seq = []
    (_cc_parse if tool == "cc" else _cx_parse)(row["path"], seq_out=seq)
    pairs = _pair_seq(seq)
    return pairs[:upto + 1] if upto is not None else pairs


def texts_of(tool, sid, limit=20):
    """用户提问文本（时间正序，前 limit 条）。"""
    if tool == "oc":
        if not db_path(required=False):
            return []
        return first_user_texts(_oc_con(), sid, limit)
    row = find_session(tool + ":" + sid)
    return (row.get("texts") or [])[:limit] if row else []


def cwd_of(row):
    for cand in (row.get("directory"), row.get("worktree")):
        if cand and os.path.isdir(cand):
            return cand
    return ""


# ---------- 单工具视图：当前工具状态（123 切换、记住上次） ----------

def tool_state_path():
    if IS_WIN:
        return os.path.join(_state_dir(), "tool-" + _tty_id())
    return "/tmp/ocs-tool-" + _tty_id()


def read_tool_file():
    """状态文件里已保存的工具；没有/不合法返回 None。"""
    try:
        with open(tool_state_path()) as f:
            t = f.read().strip()
        return t if t in ADAPTERS else None
    except OSError:
        return None


def default_tool():
    """没有历史选择时默认哪一家：会话最多的（平局按 oc→cc→cx）。"""
    counts = count_by_tool()
    return max(("oc", "cc", "cx"), key=lambda t: counts[t])


def current_tool():
    return read_tool_file() or default_tool()


def set_tool(tool):
    try:
        with open(tool_state_path(), "w") as f:
            f.write(tool)
    except OSError:
        pass


def count_by_tool():
    """各工具会话数（轻量：oc 走 COUNT，cc/cx 数缓存行）。"""
    n = {t: 0 for t in ADAPTERS}
    if db_path(required=False):
        n["oc"] = _oc_con().execute(
            "SELECT COUNT(*) FROM session WHERE parent_id IS NULL AND time_archived IS NULL"
        ).fetchone()[0]
    n["cc"] = len(cc_load())
    n["cx"] = len(cx_load())
    return n


def resume_cmd(tool, sid, fork):
    """续接命令的 argv（含命令名）。"""
    if tool == "oc":
        return ["opencode", "--session", sid] + (["--fork"] if fork else [])
    if tool == "cc":
        return ["claude", "--resume", sid]
    return ["codex", "resume", sid]


# ---------- 展示 ----------

def stats(r):
    seg = [f"{r['msgs']} 条消息"]
    tot = (r["tokens_input"] or 0) + (r["tokens_output"] or 0) + (r["tokens_reasoning"] or 0)
    if tot:
        seg.append(f"{fmt_tok(tot)} tokens")
    c = r["cost"] or 0
    if c:
        seg.append("$" + f"{c:.4f}".rstrip("0").rstrip("."))
    return " · ".join(seg)


def term_cols():
    """终端真实列数：优先问 /dev/tty（reload 等子进程的 stdout 是管道，量不到）。"""
    if IS_WIN:
        return shutil.get_terminal_size((120, 24)).columns
    try:
        fd = os.open("/dev/tty", os.O_RDONLY | os.O_NOCTTY)
        try:
            return os.get_terminal_size(fd).columns
        finally:
            os.close(fd)
    except OSError:
        return shutil.get_terminal_size((120, 24)).columns


def row_title_width():
    """列表行标题列宽：fzf 右侧预览约占一半，标题宽度自适应终端，保证不折行。"""
    cols = term_cols()
    pane = max(36, cols // 2 - 5)
    return max(16, pane - 16)


def fzf_line(r, tw, indent=""):
    """格式: 显示列 \t 会话键 \t 内容搜索文本（后两列隐藏，只参与搜索/预览取值）"""
    disp = indent + BT(pad(trunc(r["title"], tw), tw + 1))
    disp += "  " + D(pad(rel_time(r["time_updated"]), 10))
    return disp + "\t" + r["key"] + "\t" + r.get("search", "")


def print_history(tool, sid, has_reply):
    """会话预览里的历史消息：默认只显示用户提问，AI 回答在对话视图里点开。

    预览窗不可滚动，只列前 20 条；光标每动一次都重跑，避免拉全整个会话。
    """
    texts = texts_of(tool, sid, 20)
    print(f"\n{C('── 我提过的问题 ' + '─' * 20)}")
    if not texts:
        print(D("（没有文本消息）"))
        return
    for q in texts:
        print(C("•") + " " + trunc(q, 96))
    if has_reply:
        print(D("（按 → 打开对话视图，点消息行可展开/收起 AI 回答）"))
    if len(texts) == 20:
        print(D("（长会话仅列前 20 条提问，按 → 看完整对话）"))


def print_message_detail(mid):
