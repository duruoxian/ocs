def _mark_lines(grid, rgb):
    """像素网格 → 8 行半块字符画（前景=品牌色，无底色、随终端主题）。"""
    fg = _rgb_fg(rgb)
    out = []
    for y in range(0, len(grid), 2):
        row = []
        for x in range(len(grid[y])):
            t, b = grid[y][x], grid[y + 1][x]
            if t == "#" and b == "#":
                row.append(f"{fg}█{RESET}")
            elif t == "#":
                row.append(f"{fg}▀{RESET}")
            elif b == "#":
                row.append(f"{fg}▄{RESET}")
            else:
                row.append(" ")
        out.append("".join(row))
    return out


def tool_logo_lines(tool):
    """当前工具的门面 Logo，统一 8 行高（站点行位置恒定不晃）：
    opencode 像素字 4 行垂直居中（上下各补 2 空）；claude/codex mark 左缩进 3 列。"""
    if tool == "cc":
        return ["   " + l for l in _mark_lines(_CLAUDE_GRID, _CLAUDE_RGB)]
    if tool == "cx":
        return ["   " + l for l in _mark_lines(_OPENAI_GRID, _OPENAI_RGB)]
    return ["", ""] + logo_lines() + ["", ""]


