def q(s):
    """把单个参数包成当前 fzf 子 shell（cmd / sh）能正确解析的引号形式。"""
    s = str(s)
    if IS_WIN:
        return '"' + s.replace('"', '""') + '"'
    return shlex.quote(s)

RESET = "\x1b[0m"
