        "--bind=ctrl-c:ignore",
    ]
    try:
        subprocess.run(cmd, input="\n".join(l for l, _ in items), text=True)
    except FileNotFoundError:
        sys.exit("需要 fzf：请先安装（pacman -S fzf），或改用 ocs -l 列表模式")


def cmd_resume(ids, fork):
    """续接会话（fzf execute 调用）：在会话目录里启动 opencode。"""
    sid = ids[0] if ids else ""
    if not sid:
        return
    if sid.startswith("@ses:"):
        sid = sid[5:]  # 对话视图的标题行：续接该会话
    elif sid.startswith("@"):
        return  # 分组/返回行：忽略
    pm = parse_msg_id(sid)
    if pm:
        sid = pm[0]  # 消息行：续接它所属的会话
    con = connect()
    row = find_row(con, sid)
    if not row:
        sys.exit(f"找不到会话: {sid}")
    d = ""
    for cand in (row["directory"], row["worktree"]):
        if cand and os.path.isdir(cand):
            d = cand
            break
    args = ["opencode", "--session", row["id"]]
    if fork:
        args.append("--fork")
    if d:
        os.chdir(d)
    os.execvp("opencode", args)


def cmd_copy(sid):
    if not sid or sid.startswith("@"):
        return
    pm = parse_msg_id(sid)
    if pm:
        sid = pm[0]  # 消息行：复制所属会话的 ID
    con = connect()
    row = find_row(con, sid)
    if row:
        copy_to_clipboard(row["id"])
        import time
        time.sleep(0.1)  # 等 wl-copy 完成剪贴板登记，避免 ocs 退出太快丢失


def cmd_del(tokens):
    """删除处理：ses_* 为会话；@ 开头为分组（= 该组全部会话）。"""
    con = connect()
    targets = {}
    for t in tokens:
        if t.startswith("@"):
            key = t[1:]
            for r in load_sessions(con, None):
                if r["gkey"] == key:
                    targets[r["id"]] = r
        elif t.startswith("ses"):
            row = find_row(con, t)
            if row:
                targets[row["id"]] = dict(row)
        # 其他碎片（路径含空格被拆开等）忽略
    if not targets:
        return
    ordered = sorted(targets.values(), key=lambda r: -r["time_updated"])
    delete_sessions(ordered)


def cmd_fzf_lines(pid):
    con = connect()
    for l, _ in build_fzf_items(con, pid)[0]:
        print(l)


