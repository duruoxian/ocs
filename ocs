    ap.add_argument("--last", nargs="?", const=1, type=int, metavar="N",
                    help="直接继续全局最近第 N 个会话（默认 1）")
    ap.add_argument("--show", metavar="SESSION_ID", help="显示某个会话的详情（可用 id 前缀）")
    ap.add_argument("--delete", nargs="+", metavar="SESSION_ID",
                    help="删除会话（支持 id 前缀，可一次多个，删除前确认）")
    ap.add_argument("--fork", action="store_true", help="继续会话时使用 --fork 分叉")
    ap.add_argument("--select-mouse", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--toggle-mouse", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--nav-right", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--nav-left", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--click", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--print-cmd", action="store_true",
                    help="调试：--last 时打印命令；选择器模式转储列表行")
    # —— 以下为 fzf 绑定调用的内部命令 ——
    ap.add_argument("--resume", nargs="+", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--copy", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--rename", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--dels", nargs="+", metavar="TOKEN", help=argparse.SUPPRESS)
    ap.add_argument("--fzf-lines", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--pid", metavar="PROJECT_ID", help=argparse.SUPPRESS)
    args = ap.parse_args()

    con = connect()

    if args.show:
        show_detail(con, args.show)
        return

    if args.select_mouse:
        cmd_select_mouse()
        return

    if args.toggle_mouse:
        cmd_toggle_mouse()
        return

    if args.nav_right is not None:
        cmd_nav_right(args.nav_right)
        return

    if args.nav_left is not None:
        cmd_nav_left(args.nav_left)
        return

    if args.click is not None:
        cmd_click(args.click)
        return

    if args.resume is not None:
        cmd_resume(args.resume, fork=args.fork)
        return

    if args.copy:
        cmd_copy(args.copy)
        return

    if args.rename:
        if not args.rename.startswith("@"):
            row = find_row(con, args.rename)
            if row:
                rename_session(dict(row))
        return

    if args.dels is not None:
        cmd_del(args.dels)
        return

    if args.fzf_lines:
        cmd_fzf_lines(args.pid)
        return

    if args.delete:
        targets = []
        for sid in args.delete:
            r = find_row(con, sid)
            if not r:
                sys.exit(f"找不到会话: {sid}")
            targets.append(dict(r))
        ok = delete_sessions(targets)
        sys.exit(0 if ok == len(targets) else 1)

    if args.last is not None:
        rows = load_sessions(con, None)
        if len(rows) < args.last:
            sys.exit(f"目前只有 {len(rows)} 个会话，没有第 {args.last} 个")
        sys.exit(run_resume(rows[args.last - 1], fork=args.fork, dry=args.print_cmd))

    pid = resolve_project(con, args.project) if args.project else None

    if args.list or not (sys.stdin.isatty() and sys.stdout.isatty()):
        rows = load_sessions(con, pid)
        if not rows:
            sys.exit("（没有找到任何会话）")
        print_list(rows)
        return

    picker(con, pid, dry=args.print_cmd)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
