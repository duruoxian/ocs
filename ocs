import sys
import time
import unicodedata
from datetime import datetime
from urllib.request import pathname2url

TITLE_FALLBACKS = {"", "new session", "new chat", "新会话"}

RESET = "\x1b[0m"
# ── opencode 官方 Logo（字形与 opencode 内置 TUI 完全一致，颜色自适应终端）──
# 字形数据 = opencode 源码中的官方 Oa 数据；渲染规则 = 其 TUI 组件：
#   '_' 色块空格 · '^' 色块▀ · '~' 暗色▀ · ',' 暗色▄ · 其余字符按字母色
# 颜色：open=#808080（非粗体）· code=#eeeeee（粗体）
# 暗色 = 字母色 25% 叠在**终端实际背景色**上（启动时用 OSC 11 查询终端）；
# 查不到时退回 opencode 深色主题的底色 (#0a0a0a → 暗色 #282828/#434343)
_LOGO_LEFT = (
    "                   ",
    "█▀▀█ █▀▀█ █▀▀█ █▀▀▄",
    "█__█ █__█ █^^^ █__█",
    "▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀~~▀",
)
_LOGO_RIGHT = (
    "             ▄     ",
    "█▀▀▀ █▀▀█ █▀▀█ █▀▀█",
    "█___ █__█ █__█ █^^^",
    "▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀",
)
_LOGO_OPEN_RGB = (128, 128, 128)
_LOGO_CODE_RGB = (238, 238, 238)
_LOGO_FALLBACK_BG = (10, 10, 10)
_logo_bg_cache = []


def term_bg():
    """向终端查询背景色（OSC 11）；返回 (r,g,b)，终端不支持或超时返回 None。"""
    try:
        import select
        import termios
        import tty
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except (ImportError, OSError):
        return None
    try:
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)  # 关回显/行缓冲，应答不会被回显也不会被行处理截断
            os.write(fd, b"\x1b]11;?\x07")
            buf = b""
            deadline = time.monotonic() + 0.25
            while b"\x07" not in buf and b"\x1b\\" not in buf:
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                if not select.select([fd], [], [], left)[0]:
                    break
                chunk = os.read(fd, 64)
                if not chunk:
                    break
                buf += chunk
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        m = re.search(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", buf)
        if m:
            out = []
            for g in m.groups():
                v = int(g, 16)
                out.append(v >> 8 if len(g) > 2 else v)
            return tuple(out)
        m = re.search(rb"#([0-9a-fA-F]{6})", buf)
        if m:
            h = m.group(1).decode()
            return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except (OSError, ValueError):
        pass
    finally:
        os.close(fd)
    return None


def _logo_bg():
    """本次运行的终端背景色（只查一次）。"""
    if not _logo_bg_cache:
        _logo_bg_cache.append(term_bg() or _LOGO_FALLBACK_BG)
    return _logo_bg_cache[0]


def _logo_dim(rgb):
    """字母色 25% 叠在终端背景色上（opencode 原生公式：mix(bg, color, 0.25)）。"""
    bg = _logo_bg()
    return tuple((c * 25 + b * 75 + 50) // 100 for c, b in zip(rgb, bg))


def _rgb_fg(c):
    return f"\x1b[38;2;{c[0]};{c[1]};{c[2]}m"


def _rgb_bg(c):
    return f"\x1b[48;2;{c[0]};{c[1]};{c[2]}m"


def _logo_half(art, rgb, bold=False):
    """按 opencode TUI 的单元格规则渲染一半：'_'/'^' 带 25% 暗底，'~'/',' 是暗色块。"""
    fg = ("\x1b[1m" if bold else "") + _rgb_fg(rgb)
    dim = _logo_dim(rgb)
    dimfg, dimbg = _rgb_fg(dim), _rgb_bg(dim)
    out = []
    for ch in art:
        if ch == "_":
            out.append(f"{fg}{dimbg} {RESET}")
        elif ch == "^":
            out.append(f"{fg}{dimbg}▀{RESET}")
        elif ch == "~":
            out.append(f"{dimfg}▀{RESET}")
        elif ch == ",":
            out.append(f"{dimfg}▄{RESET}")
        else:
            out.append(f"{fg}{ch}{RESET}")
    return "".join(out)


def logo_lines():
    """官方 Logo 4 行：左半 open（灰 #808080）· 右半 code（白 #eeeeee、粗体）。"""
    return [
        _logo_half(l, _LOGO_OPEN_RGB) + " " + _logo_half(r, _LOGO_CODE_RGB, bold=True)
        for l, r in zip(_LOGO_LEFT, _LOGO_RIGHT)
    ]


def C(s):   # 蓝色（部分主题会把 cyan 显示成刺眼的绿色，所以统一用 blue）
    return f"\x1b[34m{s}\x1b[0m"


def M(s):   # magenta（AI 回答用）
    return f"\x1b[35m{s}\x1b[0m"


def D(s):   # dim
    return f"\x1b[2m{s}\x1b[0m"


def B(s):   # bold
    return f"\x1b[1m{s}\x1b[0m"


# ---------- 基础工具 ----------

def db_path():
    cands = []
    if os.environ.get("OPENCODE_DATA"):
        cands.append(os.path.join(os.environ["OPENCODE_DATA"], "opencode.db"))
    xdg = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    cands.append(os.path.join(xdg, "opencode", "opencode.db"))
    for c in cands:
        if os.path.isfile(c):
            return c
    sys.exit("找不到 opencode 数据库，尝试过:\n  " + "\n  ".join(cands))


def connect():
    con = sqlite3.connect("file:" + pathname2url(db_path()) + "?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    return con


def dw(s):
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in s)


def pad(s, w):
    return s + " " * max(0, w - dw(s))


def trunc(s, n):
    s = " ".join((s or "").split())
    return s if dw(s) <= n else s[:n] + "…"


def clean_text(t):
    t = (t or "").strip()
    if len(t) >= 2 and t[0] == '"' and t[-1] == '"':
        try:
            v = json.loads(t)
            if isinstance(v, str):
                t = v
        except ValueError:
            pass
    return t


def rel_time(ms):
    dt = datetime.fromtimestamp(ms / 1000)
    sec = (datetime.now() - dt).total_seconds()
    if sec < 60:
        return "刚刚"
    if sec < 3600:
        return f"{int(sec // 60)} 分钟前"
    if sec < 86400:
        return f"{int(sec // 3600)} 小时前"
    if sec < 7 * 86400:
        return f"{int(sec // 86400)} 天前"
    if dt.year == datetime.now().year:
        return dt.strftime("%m-%d %H:%M")
    return dt.strftime("%Y-%m-%d")


def abs_time(ms):
    return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M:%S")


def fmt_tok(n):
    if n >= 10000:
        return f"{n / 1000:.0f}k"
    if n >= 1000:
        return f"{n / 1000:.1f}k"
    return str(n)


def self_path():
    a0 = sys.argv[0]
    if os.path.sep in a0:
        return os.path.abspath(a0)
    return shutil.which(a0) or os.path.abspath(a0)


# ---------- 鼠标归属运行时切换 ----------
# 终端里鼠标同一时刻只能归一边：程序占用时可点击列表，但拖动/右键归程序。
# 通过转义序列在运行时切换（Konsole 实时解析，fzf 无感知），
# 让"拖动选字 + 右键复制菜单"随用随取，无需 Shift。
MOUSE_OFF = "\033[?1000l\033[?1002l\033[?1006l"  # 鼠标归终端：拖动选字、右键菜单
MOUSE_ON = "\033[?1000h\033[?1002h\033[?1006h"   # 鼠标归程序：点击列表、双击继续


def mouse_state_path():
    try:
        tty = os.path.realpath("/dev/tty")
        return "/tmp/ocs-mouse-" + os.path.basename(tty)
    except OSError:
        return "/tmp/ocs-mouse-default"


def write_tty(s):
    try:
        fd = os.open("/dev/tty", os.O_WRONLY)
        try:
            os.write(fd, s.encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def cmd_select_mouse():
    """把鼠标交给终端：拖动即选字、右键即「复制」菜单（不用 Shift）。F8 可切回。"""
    with open(mouse_state_path(), "w") as f:
        f.write("select")
    write_tty(MOUSE_OFF)


def cmd_toggle_mouse():
    """F8：在 点击模式 与 选字模式 之间切换。"""
    p = mouse_state_path()
    if os.path.exists(p):
        os.unlink(p)
        write_tty(MOUSE_ON)
    else:
        cmd_select_mouse()


# ---------- 对话视图（默认只显示用户提问，点击展开/折叠 AI 回答） ----------

def ui_state_path():
    try:
        tty = os.path.realpath("/dev/tty")
        return "/tmp/ocs-ui-" + os.path.basename(tty)
    except OSError:
        return "/tmp/ocs-ui-default"


def ui_state():
    try:
        with open(ui_state_path()) as f:
            st = json.load(f)
            if isinstance(st, dict):
                return st
    except (OSError, ValueError):
        pass
    return {"view": "list"}


def ui_state_set(st):
    try:
        with open(ui_state_path(), "w") as f:
            json.dump(st, f)
    except OSError:
        pass


def ui_state_clear():
    try:
        os.unlink(ui_state_path())
    except OSError:
        pass


def parse_msg_id(mid):
    """消息行 id 形如 m:<session_id>:<序号>；不是消息行返回 None。"""
    if not mid.startswith("m:"):
        return None
    parts = mid.split(":")
    if len(parts) != 3 or not parts[2].isdigit():
        return None
    return parts[1], int(parts[2])


def toggle_msg(mid):
    """点击/展开某条消息：切换其 AI 回答的显示状态。"""
    pm = parse_msg_id(mid)
    if not pm:
        return
    sid, idx = pm
    st = ui_state()
    if st.get("view") != "msg" or st.get("sid") != sid:
        return
    exp = set(st.get("expanded", []))
    exp.symmetric_difference_update({idx})
    st["expanded"] = sorted(exp)
    ui_state_set(st)


def cmd_nav_right(mid):
    """→：会话行=打开对话视图；消息行=展开/折叠 AI 回答。"""
    pm = parse_msg_id(mid)
    if pm:
        toggle_msg(mid)
        return
    if mid.startswith("ses"):
        ui_state_set({"view": "msg", "sid": mid, "expanded": []})


def cmd_nav_left(mid):
    """←：返回会话列表。"""
    ui_state_set({"view": "list"})


def cmd_click(mid):
    """单击：返回行=回到列表；消息行=展开/折叠；其他行不做任何事。"""
    if mid == "@back":
        return cmd_nav_left(mid)
    toggle_msg(mid)


def message_pairs(con, sid):
    """按时间正序返回 [(用户消息, 紧随其后的 AI 回复文本或 "")]。"""
    rows = con.execute(
        "SELECT id, data FROM message WHERE session_id = ? ORDER BY time_created, id",
        (sid,),
    ).fetchall()
    pairs, cur = [], None
    for mid, mdata in rows:
        try:
            role = json.loads(mdata).get("role")
        except ValueError:
            role = None
        texts = []
        for (d,) in con.execute(
            """SELECT data FROM part WHERE message_id = ?
               AND json_extract(data, '$.type') = 'text' ORDER BY id""",
            (mid,),
        ):
            try:
                t = clean_text(json.loads(d).get("text", ""))
            except ValueError:
                t = ""
            if t:
                texts.append(t)
        body = " ".join(" ".join(texts).split())
        if role == "user":
            if cur:
                pairs.append(cur)
            cur = [body, ""]
        elif role == "assistant" and cur is not None:
            cur[1] = (cur[1] + " " + body).strip() if cur[1] else body
    if cur:
        pairs.append(cur)
    return pairs


# ---------- 数据库查询 ----------

SQL = """
SELECT s.id, s.title, s.directory, s.time_created, s.time_updated,
       s.cost, s.tokens_input, s.tokens_output, s.tokens_reasoning,
       s.model, s.agent, s.summary_additions, s.summary_deletions, s.summary_files,
       p.id AS pid, p.name AS pname, p.worktree AS worktree
FROM session s LEFT JOIN project p ON p.id = s.project_id
WHERE s.parent_id IS NULL AND s.time_archived IS NULL
"""


def find_row(con, sid):
    r = con.execute(SQL + " AND s.id = ?", (sid,)).fetchone()
    if r:
        return r
    if len(sid) >= 6:  # 允许传 id 前缀，只要能唯一匹配
        rows = con.execute(SQL + " AND s.id LIKE ? || '%'", (sid,)).fetchall()
        if len(rows) == 1:
            return rows[0]
        if len(rows) > 1:
            sys.exit("前缀 %r 匹配到多个会话，请用更长的 id:\n  "
                     % sid + "\n  ".join(x["id"] for x in rows))
    return None


def group_of(r):
    """分组键：真实项目按项目分组；挂在 '/' 下的会话按实际运行目录分组。"""
    wt = r.get("worktree") or ""
    if wt and wt != "/" and r.get("pid"):
        return ("p:" + r["pid"], r.get("pname") or proj_label(r), wt)
    d = r.get("directory") or wt or "?"
    return ("d:" + d, os.path.basename(d.rstrip("/")) or d, d)


def load_sessions(con, pid):
    sql, params = SQL, []
    if pid:
        sql += " AND s.project_id = ?"
        params.append(pid)
    rows = [dict(r) for r in con.execute(sql, params)]
    counts = dict(con.execute("SELECT session_id, COUNT(*) FROM message GROUP BY session_id"))
    for r in rows:
        r["msgs"] = counts.get(r["id"], 0)
        ensure_title(con, r)
        r["gkey"], r["glabel"], r["gpath"] = group_of(r)
    rows.sort(key=lambda r: r["time_updated"], reverse=True)
    return rows


def ensure_title(con, r):
    t = (r["title"] or "").strip()
    if t.lower() in TITLE_FALLBACKS:
        t = ""
    if not t:
        texts = first_user_texts(con, r["id"], 1)
        t = trunc(texts[0], 30) if texts else "(无标题)"
    r["title"] = t


def first_user_texts(con, sid, limit=None):
    """用户消息文本，时间正序。limit=None 取全部。"""
    sql = """SELECT p2.data FROM message m JOIN part p2 ON p2.message_id = m.id
             WHERE m.session_id = ? AND json_extract(m.data, '$.role') = 'user'
               AND json_extract(p2.data, '$.type') = 'text'
             ORDER BY m.time_created, p2.id"""
    params = [sid]
    if limit:
        sql += " LIMIT ?"
        params.append(limit)
    out = []
    for r in con.execute(sql, params):
        try:
            t = clean_text(json.loads(r[0]).get("text", ""))
        except ValueError:
            t = ""
        if t:
            out.append(t)
    return out


def last_assistant_text(con, sid):
    row = con.execute(
        """SELECT id FROM message
           WHERE session_id = ? AND json_extract(data, '$.role') = 'assistant'
           ORDER BY time_created DESC, id DESC LIMIT 1""",
        (sid,),
    ).fetchone()
    if not row:
        return ""
    texts = []
    for (d,) in con.execute(
        """SELECT data FROM part WHERE message_id = ?
           AND json_extract(data, '$.type') = 'text' ORDER BY id""",
        (row[0],),
    ):
        try:
            t = clean_text(json.loads(d).get("text", ""))
        except ValueError:
            t = ""
        if t:
            texts.append(t)
    return "\n".join(texts)


def search_text(con, r):
    """会话内容摘要：用于 fzf 全文搜索（隐藏字段）。"""
    parts = first_user_texts(con, r["id"], 2)
    reply = last_assistant_text(con, r["id"])
    if reply:
        parts.append(reply)
    return " ".join(" ".join(parts).split())[:400]


def model_of(con, r):
    m = r.get("model")
    if m:
        if m.startswith("{"):  # session.model 存的是 JSON 对象
            try:
                mm = json.loads(m)
                return f"{mm.get('providerID', '?')}/{mm.get('id') or mm.get('modelID', '?')}"
            except ValueError:
                pass
        return m
    q = con.execute(
        """SELECT data FROM message WHERE session_id = ?
           AND json_extract(data, '$.model') IS NOT NULL
           ORDER BY time_created LIMIT 1""",
        (r["id"],),
    ).fetchone()
    if q:
        try:
            mm = json.loads(q[0])["model"]
            return f"{mm.get('providerID', '?')}/{mm.get('modelID', '?')}"
        except (ValueError, KeyError):
            pass
    return "—"


def proj_label(r):
    if r.get("pname"):
        return r["pname"]
    wt = r.get("worktree") or ""
    if wt == "/":
        return "/"
    return os.path.basename(wt.rstrip("/")) or wt or "?"


def project_dirs(con, pid):
    ds = set()
    prow = con.execute("SELECT worktree FROM project WHERE id = ?", (pid,)).fetchone()
    if prow and prow[0]:
        ds.add(prow[0])
    for (d,) in con.execute("SELECT directory FROM project_directory WHERE project_id = ?", (pid,)):
        ds.add(d)
    return {d for d in ds if d}


def dir_match(d, target):
    d = d.rstrip("/") or "/"
    return target == d or target.startswith(d.rstrip("/") + "/")


def resolve_project(con, target):
    target = os.path.abspath(os.path.expanduser(target))
    projects = con.execute("SELECT id, worktree, name FROM project").fetchall()
    for r in projects:
        if r["worktree"] and os.path.abspath(r["worktree"]) == target:
            return r["id"]
    for r in projects:
        if any(dir_match(d, target) for d in project_dirs(con, r["id"])):
            return r["id"]
    sys.exit(
        f"没有找到与 {target} 关联的项目。已知项目:\n"
        + "\n".join(f"  {r['worktree']}  {r['name'] or ''}" for r in projects)
    )


# ---------- 展示 ----------

def stats(r):
    seg = [f"{r['msgs']} 条消息"]
    tot = (r["tokens_input"] or 0) + (r["tokens_output"] or 0) + (r["tokens_reasoning"] or 0)
    if tot:
        seg.append(f"{fmt_tok(tot)} tokens")
    c = r["cost"] or 0
    if c:
        seg.append("$" + f"{c:.4f}".rstrip("0").rstrip("."))
    return " · ".join(seg)


def term_cols():
    """终端真实列数：优先问 /dev/tty（reload 等子进程的 stdout 是管道，量不到）。"""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY | os.O_NOCTTY)
        try:
            return os.get_terminal_size(fd).columns
        finally:
            os.close(fd)
    except OSError:
        return shutil.get_terminal_size((120, 24)).columns


def row_title_width():
    """列表行标题列宽：fzf 右侧预览约占一半，标题宽度自适应终端，保证不折行。"""
    cols = term_cols()
    pane = max(36, cols // 2 - 5)
    return max(16, pane - 16)


def fzf_line(r, tw, indent=""):
    """格式: 显示列 \\t 会话id \\t 内容搜索文本（后两列隐藏，只参与搜索/预览取值）"""
    disp = indent + B(pad(trunc(r["title"], tw), tw + 1))
    disp += "  " + D(pad(rel_time(r["time_updated"]), 10))
    return disp + "\t" + r["id"] + "\t" + r.get("search", "")


def print_history(con, sid):
    """会话预览里的历史消息：默认只显示用户提问，AI 回答在对话视图里点开。"""
    pairs = message_pairs(con, sid)
    print(f"\n{C('── 我提过的问题 ' + '─' * 20)}")
    if not pairs:
        print(D("（没有文本消息）"))
        return
    for q, _ in pairs:
        print(C("•") + " " + trunc(q, 96))
    if any(a for _, a in pairs):
        print(D("（按 → 打开对话视图，点消息行可展开/收起 AI 回答）"))


def print_message_detail(con, mid):
    """对话视图里某条消息的详情：完整显示提问与对应的 AI 回答。"""
    pm = parse_msg_id(mid)
    if not pm:
        return
    sid, idx = pm
    pairs = message_pairs(con, sid)
    if idx >= len(pairs):
        print(D("（消息不存在）"))
        return
    q, a = pairs[idx]
    print(B(f"第 {idx + 1} / {len(pairs)} 条"))
    print(f"\n{C('提问│')}{q}")
    print(f"\n{M('AI │')}" + (a if a else D("（没有文本回答）")))


