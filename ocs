def opencode_exe():
    """opencode 可执行文件；缺失时给中文提示而不是裸 traceback。"""
    exe = shutil.which("opencode")
    if not exe:
        sys.exit("未找到 opencode 命令：请先安装 opencode 并加入 PATH")
    return exe


def _proc_info(pid):
    """(进程名, 父pid)。Linux 读 /proc；macOS 没有 /proc，用 ps（仅点工具行时调用）。"""
    if IS_MAC:
        try:
            comm = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)],
                                  capture_output=True, text=True, timeout=2).stdout.strip()
            ppid = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                                  capture_output=True, text=True, timeout=2).stdout.strip()
            return os.path.basename(comm or ""), (int(ppid) if ppid.isdigit() else 0)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return "", 0
    try:
        with open(f"/proc/{pid}/comm") as f:
            comm = f.read().strip()
        with open(f"/proc/{pid}/stat") as f:
            ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        return comm, ppid
    except (OSError, ValueError, IndexError):
        return "", 0


def kill_fzf():
    """fzf execute 子进程里向上找到 fzf 并终止它（点工具行切换时用）：
    ocs 外层随后检测到工具状态文件变化，以新工具重启 picker。"""
    if IS_WIN:  # Windows 下退化为「列表已切换、重启后 logo 生效」
        return
    pid = os.getppid()
    for _ in range(4):
        if not pid or pid <= 1:
            return
        name, ppid = _proc_info(pid)
        if name in ("fzf", "fzf.exe"):
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
            return
        pid = ppid


def _launch(tool, argv, d):
    """在会话目录里启动对应 CLI：POSIX 下 execvp 替换进程，Windows 下等退出。"""
    exe = shutil.which(argv[0])
    if not exe:
        sys.exit(f"未找到 {argv[0]} 命令：请先安装 {ADAPTERS[tool]['name']} 并加入 PATH")
    if IS_WIN:
        sys.exit(subprocess.run([exe] + argv[1:], cwd=d or None).returncode)
    if d:
        os.chdir(d)
    os.execvp(exe, [exe] + argv[1:])


def run_resume(row, fork, dry):
    """--last 的续接：dry=True 只打印命令；否则启动后进程即被替换。"""
    argv = resume_cmd(row["tool"], row["id"], fork)
    d = cwd_of(row)
    if dry:
        print((f"cd {shlex.quote(d)} && " if d else "") + shlex.join(argv))
        return 0
    t = trunc(row["title"], 50)
    print(D(f"▸ 继续会话: {t} ({rel_time(row['time_updated'])}) — {argv[0]} 退出后回到列表"))
    _launch(row["tool"], argv, d)


def delete_sessions(targets):
    """删除会话列表（跨工具：oc 走 CLI，cc/cx 删会话文件），已含确认。返回成功数。"""
    oc = [r for r in targets if r["tool"] == "oc"]
    exe = opencode_exe() if oc else None  # 先确认可用性，再让用户确认删除
    print("将删除:")
    for r in targets[:8]:
        loc = r.get("path") or r["id"]
        print("  " + trunc(r["title"], 44) + D(f"  [{r['tool']}] {loc}"))
    if len(targets) > 8:
        print(D(f"  … 共 {len(targets)} 个"))
    try:
        ans = input(f"确认删除 {len(targets)} 个会话? [y/N] ").strip().lower()
    except (EOFError, OSError):
        return 0
    if ans not in ("y", "yes"):
        print("已取消")
        return 0
    ok = 0
    for r in targets:
        if r["tool"] == "oc":
            rc = subprocess.run([exe, "session", "delete", r["id"]]).returncode
            ok += rc == 0
            print(("✓ 已删除 " if rc == 0 else "✗ 删除失败 ") + r["id"])
            continue
        root = os.path.realpath(os.path.join(
            cc_root() if r["tool"] == "cc" else cx_root(),
            "projects" if r["tool"] == "cc" else "sessions"))
        p = os.path.realpath(r["path"] or "")
        if not p.startswith(root + os.sep):  # 护栏：只删各工具会话目录里的文件
            print("✗ 路径不在会话目录内，拒绝删除 " + (p or r["id"]))
            continue
        try:
            os.unlink(p)
            ok += 1
            print("✓ 已删除 " + p)
        except OSError as e:
            print(f"✗ 删除失败 {r['id']}: {e}")
    return ok


def copy_to_clipboard(text):
    """写入系统剪贴板：Windows 用 clip；macOS 用 pbcopy；Linux 用 wl-copy → xclip/xsel → OSC 52。"""
    if IS_WIN:
        try:
            p = subprocess.Popen(["clip"], stdin=subprocess.PIPE, shell=False)
            p.communicate(text.encode("utf-16le"))  # clip 按 UTF-16LE 读入
            return p.returncode == 0
        except OSError:
            pass
        try:
            subprocess.run(["powershell", "-NoProfile", "-Command", "Set-Clipboard"],
                           input=text, text=True, capture_output=True, timeout=10)
            return True
        except (OSError, subprocess.TimeoutExpired):
            return False
    if IS_MAC:
        try:  # pbcopy 读完 stdin 即退出，可直接等它
            subprocess.run(["pbcopy"], input=text.encode(), timeout=5, check=False)
            return True
        except (OSError, subprocess.TimeoutExpired):
            return False
    try:
        # wl-copy 会常驻后台提供剪贴板服务，不能等待其退出
        p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        p.stdin.write(text.encode())
        p.stdin.close()
        return True
    except (FileNotFoundError, OSError):
        pass
    for cmd in (["xclip", "-selection", "clipboard"], ["xsel", "-b"]):
        try:
            if subprocess.run(cmd, input=text, text=True, capture_output=True,
                              timeout=5).returncode == 0:
                return True
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
    try:
        import base64
        sys.stdout.write("\033]52;c;" + base64.b64encode(text.encode()).decode() + "\07")
        sys.stdout.flush()
    except Exception:
        pass
    return False


def rename_session(row):
    """重命名会话：直接更新 opencode 数据库中的标题。"""
    try:
        import readline  # noqa: F401  让输入支持方向键/编辑
    except ImportError:
        pass
    try:
        new = input(f"新标题（回车确认，留空取消）[{row['title']}]: ").strip()
    except (EOFError, OSError):
        return
    if not new or new == row["title"]:
        return
    con2 = sqlite3.connect(db_path())
    try:
        con2.execute("UPDATE session SET title = ? WHERE id = ?", (new, row["id"]))
        con2.commit()
    except sqlite3.OperationalError as e:
        print(f"✗ 重命名失败：{e}")
        print(D("（opencode 可能正占用数据库，稍后再试；原标题未改动）"))
        return
    finally:
        con2.close()
    row["title"] = new


def build_msg_items(con, key):
    """对话视图的列表行：标题行 + 返回行 + 用户提问行（展开状态下附带 AI 回答行）。"""
    row = find_session(key)
    if not row:
        return None
    tool, sid = row["tool"], row["id"]
    if tool == "oc":
        ensure_title(con, row)
    st = ui_state()
    expanded = set(st.get("expanded", [])) if st.get("key") == key else set()
    items = []
    items.append((B("◆ " + trunc(row["title"], 60)) + "\t@ses:" + key + "\t", None))
    items.append((D("← 返回会话列表") + "\t@back\t", None))
    pairs = pairs_of(tool, sid)
    for i, (q, a) in enumerate(pairs):
        mid = f"m:{tool}:{sid}:{i}"
        disp = C("提问│") + trunc(q, 160)
        items.append((disp + "\t" + mid + "\t" + oneline(q + " " + a), None))
        if i in expanded:
            body = oneline(a) if a else "（没有文本回答）"
            items.append((M("AI │") + body + "\t" + mid + "\t" + oneline(a), None))
    return items


def build_fzf_items(con, under, tool, counts=None):
    """按当前视图构造 fzf 列表行。返回 (items, 会话总数)。"""
    st = ui_state()
    counts = counts or count_by_tool()
    items = []
    if st.get("view") != "msg":
        # 列表顶部 3 行工具行：点击/回车切换视图工具（不占数字键，搜索不受影响）
        for t in ("oc", "cc", "cx"):
            label = f"{ADAPTERS[t]['name']}  {counts[t]}"
            disp = (B(C("▸ " + label)) if t == tool else HG("  " + label))
            items.append((disp + "\t@tool:" + t + "\t", None))
    if st.get("view") == "msg" and st.get("key"):
        mitems = build_msg_items(con, st["key"])
        if mitems is not None:
            # 只要一个计数，不必把所有会话的消息都载入一遍
            total = (len(load_all(under, tool)) if under
                     else (counts[tool] if tool else sum(counts.values())))
            return items + mitems, total
        ui_state_clear()  # 会话没了：回列表
    rows = load_all(under, tool)  # r["search"] 已在其中生成
    tw = row_title_width()
    if not rows:  # 该工具还没有会话（没装/没用过）：给占位行，进得来、不报错
        items.append((D("（该工具还没有会话——在终端里用它聊一次，回来就能看到）"
                        + "\t@empty\t"), None))
        return items, 0
    if under is not None:  # -p 指定目录：不加分组头
        items += [(fzf_line(r, tw), r) for r in rows]
    else:
        groups = {}
        for r in rows:  # rows 已按时间倒序 → 分组按最近活动排序，组内按时间倒序
            groups.setdefault(r["gkey"], []).append(r)
        pane = max(36, term_cols() // 2 - 5)  # 与列表窗格等宽，标题行不折行
        for gkey, group in groups.items():
            first = group[0]
            name = trunc(first["glabel"], 16)
            tail = f" · {len(group)} 个会话"
            budget = max(8, pane - 5 - dw(name) - dw(tail))
            head = (B(A("◆ " + name)) + A("  " + trunc(first["gpath"], budget) + tail))
            items.append((head + "\t@" + gkey + "\t", None))
            items += [(fzf_line(r, tw, indent="  "), r) for r in group]
    return items, len(rows)


# fzf 信息栏：默认的 "< n/m (0) +T ────" 太吵（+T 是 --track 的标记，后面还跟着一条
# 分隔线）。改为自绘：有过滤词时显示 "位置/匹配数"（0 条时"无匹配"），多选时追加
# "已选 n"，其余时间整行留空；计数放提示行最右端，样式压暗。
_FZF_INFO_CMD = (
    'i="";'
    ' if [ -n "$FZF_QUERY" ]; then'
    '   if [ "${FZF_MATCH_COUNT:-0}" -eq 0 ]; then i="无匹配"; else i="$FZF_POS/$FZF_MATCH_COUNT"; fi;'
    ' fi;'
    ' if [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then i="${i:+$i · }已选 $FZF_SELECT_COUNT"; fi;'
    ' [ -n "$i" ] && printf "\\033[2m%s\\033[0m" "$i"; exit 0'
)


def _tool_sig():
    """工具状态文件签名（mtime+size）：区分「点了工具行」与「esc」
    （两者都让 fzf 退出，只有点工具行才会写状态文件）。"""
    try:
        st = os.stat(tool_state_path())
        return (st.st_mtime_ns, st.st_size)
    except OSError:
        return None


def _hint(segs):
    """键位提示行：键名亮白、说明灰、分隔点更暗——点点不再和文字一个样。"""
    return DG(" · ").join(
        BT(k) + (HG(" " + v) if v else "") for k, v in segs
    )


def picker(con, under, dry):
    """单工具视图：header 只画当前一家的 Logo，列表只载这一家的会话；
    点击列表顶部工具行切换 = 写状态文件 + 让 fzf 退出 → 外层以新工具重启
    （header 随之重画；ocs 绝不向 fzf 外打印任何行，esc 退出后终端原样）。"""
    try:
        os.unlink(mouse_state_path())  # 新会话从点击模式开始
    except OSError:
        pass
    ui_state_clear()  # 新会话从会话列表开始
    while True:
        tool = current_tool()
        sig0 = _tool_sig()
        _run_picker(con, under, dry, tool)
        if _tool_sig() == sig0:  # esc（文件没动）= 真退出
            return


def _run_picker(con, under, dry, tool):
    """跑一次 fzf；fzf 退出后由外层比较工具状态文件签名决定重启还是退出。"""
    script = self_cmd()
    if dry:  # 调试：转储列表行
        for l, _ in build_fzf_items(con, under, tool)[0]:
            print(repr(l))
        return
    items, _ = build_fzf_items(con, under, tool)
    if IS_WIN:
        copy_hint = _hint([("ctrl-y", "复制会话 ID"), ("拖动", "选中文字，右键「复制」")])
    else:
        copy_hint = _hint([("右键/F8", "交鼠标给终端：拖动选中、右键「复制」"),
                           ("F8", "切回点击模式")])
    header = (
        "\n".join(tool_logo_lines(tool))
        + "\n" + HG("GitHub github.com/duruoxian   博客 duruoxian-blog.pages.dev")
        + "\n" + _hint([("打字", "过滤（含聊天内容）"), ("↑↓", "选择"), ("回车", "继续"),
                        ("点击工具行", "切换")])
        + "\n" + _hint([("→", "对话视图"), ("←", "返回"),
                        ("点击消息行", "展开/收起 AI 回答")])
        + "\n" + _hint([("ctrl-r", "重命名"), ("ctrl-d", "删除（组头=整组，tab 多选）"),
                        ("esc", "退出")])
        + "\n" + copy_hint
    )
    # 所有操作通过 execute 在界面内完成，reload 刷新列表；esc 才退出
    # （reload 不带 --tool：--fzf-lines 跟随工具状态文件，Windows 下点工具行也即时生效）
    reload_cmd = script + " --fzf-lines" + (f" --under {q(under)}" if under else "")
    cmd = [
        "fzf", "--ansi", "--layout=reverse", "--multi", "--marker=✓", "--wrap=word", "--track",
        "--delimiter=\t", "--with-nth=1",
        f"--preview={script} --show {{2}}" + (f" --tool {q(tool)}" if tool else ""),
        "--preview-window=right:50%:wrap:border-left",
        "--prompt=会话❯ ",
        "--info=inline-right:",   # 计数自绘（见 _FZF_INFO_CMD），放提示行最右侧
        "--no-separator",         # 不要横贯提示行的 ─── 分隔线
        "--no-scrollbar",         # 列表侧滚动条紧贴 border 会看成两条竖线（fzf 默认开）
        "--info-command=" + _FZF_INFO_CMD,
        f"--header={header}",
        "--color=prompt:blue,pointer:blue,header:dim",
        "--height=100%",          # 全屏：预览分隔线从顶贯穿到底，esc 退出终端原样恢复
        f"--bind=enter:execute({script} --resume {{2}})+reload({reload_cmd})",
        f"--bind=ctrl-e:execute({script} --fork --resume {{2}})+reload({reload_cmd})",
        f"--bind=ctrl-y:execute-silent({script} --copy {{2}})",
        f"--bind=ctrl-r:execute({script} --rename {{2}})+reload({reload_cmd})",
        f"--bind=ctrl-d:execute({script} --dels {{+2}})+reload({reload_cmd})",
        f"--bind=double-click:execute({script} --resume {{2}})+reload({reload_cmd})",
        # 对话视图：→ 打开/展开 · ← 返回 · 单击消息行=展开/收起 AI 回答
        f"--bind=right:execute-silent({script} --nav-right {{2}})+reload({reload_cmd})",
        f"--bind=left:execute-silent({script} --nav-left {{2}})+reload({reload_cmd})",
        f"--bind=left-click:execute-silent({script} --click {{2}})+reload({reload_cmd})",
    ]
    if not IS_WIN:
        # 右键/F8 切换鼠标归属是 Linux 终端专属（Windows 终端不支持该转义序列）
        cmd += [
            f"--bind=right-click:execute-silent({script} --select-mouse)",
            f"--bind=F8:execute-silent({script} --toggle-mouse)",
        ]
    # Ctrl+C 交给终端（选中文字时复制）；在 ocs 内不响应，避免误退出
    cmd.append("--bind=ctrl-c:ignore")
    try:
        subprocess.run(cmd, input="\n".join(l for l, _ in items), text=True,
                       encoding="utf-8", errors="replace")
    except FileNotFoundError:
        sys.exit("需要 fzf：请先安装（Windows: winget install junegunn.fzf；"
                 "Linux: pacman -S fzf），或改用 ocs -l 列表模式")


def cmd_resume(ids, fork):
    """续接会话（fzf execute 调用）：在会话目录里启动对应 CLI。"""
    key = ids[0] if ids else ""
    if not key:
        return
    if key.startswith("@ses:"):
        key = key[5:]  # 对话视图的标题行：续接该会话
    elif key.startswith("@tool:"):
        t = key[6:]
        if t in ADAPTERS:
            set_tool(t)
            kill_fzf()  # 回车在工具行上 = 同点击切换
        return
    elif key.startswith("@"):
        return  # 分组/返回行：忽略
    pm = parse_msg_id(key)
    if pm:
        key = pm[0] + ":" + pm[1]  # 消息行：续接它所属的会话
    tool, _ = split_key(key)
    if tool is None:
        return
    row = find_session(key)
    if not row:
        sys.exit(f"找不到会话: {key}")
    if fork and tool != "oc":
        print(D(f"（{ADAPTERS[tool]['name']} 会话暂不支持分叉，按原会话继续）"))
        fork = False
    argv = resume_cmd(tool, row["id"], fork)
    _launch(tool, argv, cwd_of(row))


def cmd_copy(key):
    if not key or key.startswith("@"):
        return
    pm = parse_msg_id(key)
    if pm:
        key = pm[0] + ":" + pm[1]  # 消息行：复制所属会话的 ID
    row = find_session(key)
    if row:
        copy_to_clipboard(row["id"])
        if not IS_WIN:
            time.sleep(0.1)  # 等 wl-copy 完成剪贴板登记，避免 ocs 退出太快丢失


def cmd_del(tokens, tool=None):
    """删除处理：oc:/cc:/cx: 为会话；@ 开头为分组（= 该组全部会话）；其余碎片忽略。
    单工具视图下组只展开该工具的会话（用户看不到别家的行，就不能删到别家）。"""
    targets = {}
    for t in tokens:
        if t.startswith("@"):
            key = t[1:]
            if key.startswith("ses:"):  # 对话视图标题行：不删
                continue
            for r in load_all(tool=tool):
                if r["gkey"] == key:
                    targets[r["key"]] = r
        else:
            row = find_session(t)  # 无法识别的碎片（路径被空格拆开等）返回 None
            if row:
                targets[row["key"]] = row
    if not targets:
        return
    ordered = sorted(targets.values(), key=lambda r: -r["time_updated"])
    delete_sessions(ordered)


def cmd_fzf_lines(under, tool):
    if not tool:  # reload 不带 --tool 时跟随状态文件：Windows 下点工具行
        tool = current_tool()  # （fzf 不退出，靠 reload）也能立刻换成新工具的列表
    con = _oc_con() if db_path(required=False) else None
    for l, _ in build_fzf_items(con, under, tool)[0]:
        print(l)


# ---------- 入口 ----------

def main():
    if not IS_WIN:  # reload/execute 子进程在后台进程组，tty 访问会被停死（spinner 永转假死）
        import signal
        signal.signal(signal.SIGTTOU, signal.SIG_IGN)
        signal.signal(signal.SIGTTIN, signal.SIG_IGN)
    ap = argparse.ArgumentParser(
        prog="ocs",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Open Coding Sessions——opencode / claude code / codex 会话选择器："
                    "单工具视图浏览三家历史会话，点工具行切换；搜索含会话内容，"
                    "回车切回、可重命名、可批量删除。",
        epilog="""\
使用教程:
  【打开与浏览】
    ocs              打开会话列表（所有项目，按项目分组）
    打字             过滤，可搜标题和会话里聊过的内容
    ↑ / ↓            上下选择，右侧实时预览详情
    回车 / 双击      继续选中的会话；退出 opencode 后自动回到列表
    滚轮             浏览列表

  【对话视图（看聊天记录）】
    →                打开当前会话的对话视图（默认只显示你提过的问题）
    点击某条提问     展开它的 AI 回答；再点一次收起（→ 键同效）
    ←                返回会话列表
    右侧预览         显示光标所在那一条的完整问答

  【复制文字】
    右键一次 / F8    把鼠标交给终端：按住拖动=选中文字，右键=「复制」菜单
                     （都不用按 Shift）；再按 F8 切回点击模式
    ctrl-y           一键复制当前会话 ID

  【会话管理】
    ctrl-r 重命名 · ctrl-e 分叉 · ctrl-d 删除（组头=删整组，tab 多选=批量删）
    tab 多选 · ctrl-a 全选 · esc 退出

  【命令行】
    ocs -p /path/项目       只看指定项目
    ocs --last [N]          直接继续最近第 N 个会话
    ocs --show ID           查看详情（m:<会话ID>:<序号> 看单条消息）
    ocs --delete ID...      删除会话（支持 id 前缀、多个，删除前确认）
    ocs -l                  纯文本列表（适合管道/脚本）
""",
    )
    ap.add_argument("-p", "--project", metavar="DIR", help="只看指定目录（含其子目录）的会话")
    ap.add_argument("-l", "--list", action="store_true",
                    help="列表模式输出（非交互，适合管道）")
    ap.add_argument("--last", nargs="?", const=1, type=int, metavar="N",
                    help="直接继续全局最近第 N 个会话（默认 1）")
    ap.add_argument("--show", metavar="SESSION_ID", help="显示某个会话的详情（可用 id 前缀）")
    ap.add_argument("--delete", nargs="+", metavar="SESSION_ID",
                    help="删除会话（支持 id 前缀，可一次多个，删除前确认）")
    ap.add_argument("--fork", action="store_true", help="继续会话时使用 --fork 分叉")
    ap.add_argument("--select-mouse", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--toggle-mouse", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--nav-right", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--nav-left", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--click", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--print-cmd", action="store_true",
                    help="调试：--last 时打印命令；选择器模式转储列表行")
    # —— 以下为 fzf 绑定调用的内部命令 ——
    ap.add_argument("--resume", nargs="+", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--copy", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--rename", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--dels", nargs="+", metavar="TOKEN", help=argparse.SUPPRESS)
    ap.add_argument("--fzf-lines", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--under", metavar="DIR", help=argparse.SUPPRESS)
    ap.add_argument("--tool", metavar="TOOL", help=argparse.SUPPRESS)
    args = ap.parse_args()

    # 鼠标/视图状态类子命令不碰数据库（点击、右键、F8 每次都会走），
    # 也不应因找不到 opencode.db 而失效
    if args.select_mouse:
        cmd_select_mouse()
        return

    if args.toggle_mouse:
        cmd_toggle_mouse()
        return

    if args.nav_right is not None:
        cmd_nav_right(args.nav_right)
        return

    if args.nav_left is not None:
        cmd_nav_left(args.nav_left)
        return

    if args.click is not None:
        cmd_click(args.click)
        return

    # opencode 没装/没用过时仍可只看 claude code / codex；三家全缺才报错
    con = None
    if db_path(required=False):
        con = connect()
    elif not (os.path.isdir(os.path.join(cc_root(), "projects"))
              or os.path.isdir(os.path.join(cx_root(), "sessions"))):
        sys.exit("找不到任何会话数据：opencode / claude code / codex 都没装或没用过\n"
                 "（opencode 数据应在 ~/.local/share/opencode/opencode.db）")

    if args.show:
        show_detail(con, args.show, args.tool)
        return

    if args.resume is not None:
        cmd_resume(args.resume, fork=args.fork)
        return

    if args.copy:
        cmd_copy(args.copy)
        return

    if args.rename:
        row = find_session(args.rename) if split_key(args.rename)[0] else None
        if row and row["tool"] == "oc":
            rename_session(row)
        elif row:
            print(D(f"（{ADAPTERS[row['tool']]['name']} 会话暂不支持重命名）"))
        return

    if args.dels is not None:
        cmd_del(args.dels, args.tool)
        return

    if args.fzf_lines:
        cmd_fzf_lines(args.under, args.tool)
        return

    if args.delete:
        targets = []
        for token in args.delete:
            row = find_session(token if ":" in token else "oc:" + token)
            if not row:
                sys.exit(f"找不到会话: {token}")
            targets.append(row)
        ok = delete_sessions(targets)
        sys.exit(0 if ok == len(targets) else 1)

    if args.last is not None:
        rows = load_all()
        if len(rows) < args.last:
            sys.exit(f"目前只有 {len(rows)} 个会话，没有第 {args.last} 个")
        sys.exit(run_resume(rows[args.last - 1], fork=args.fork, dry=args.print_cmd))

    under = os.path.abspath(os.path.expanduser(args.project)) if args.project else None

    if args.list or not (sys.stdin.isatty() and sys.stdout.isatty()):
        rows = load_all(under)
        if not rows:
            sys.exit("（没有找到任何会话）")
        print_list(rows)
        return

    picker(con, under, dry=args.print_cmd)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
